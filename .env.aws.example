# Copy to .env.aws and fill in. Never commit .env.aws.
DEPLOY_REGION=ap-southeast-2

# AWS credentials of an IAM user that may create the stack (or use a named profile instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Your public IP in CIDR form (e.g. 203.0.113.4/32); allowed to open the n8n editor.
# Leave empty to detect it automatically.
ADMIN_CIDR=

# Database (use letters and digits only in the password: it goes into a connection URL)
DB_USER=appuser
DB_PASSWORD=
DB_NAME=loan_engine

# Shared secrets and keys
WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Used when the main model is overloaded (503)
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# n8n host size (check which instance types your account plan allows)
N8N_INSTANCE_TYPE=t3.small

# SES: verified sender, plus an IAM user's keys that may call ses:SendEmail
SES_FROM=you@gmail.com
SES_REGION=ap-southeast-2
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# Demo guard: at most NOTIFY_LIMIT emails per run, only to these (SES-verified) addresses
NOTIFY_LIMIT=2
NOTIFY_RECIPIENTS=you@gmail.com,you+two@gmail.com
