# Copy to .env for local development. Never commit .env.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=loan-engine-uploads

# Shared between the processor and the n8n webhook check
WEBHOOK_SECRET=change-me-three
N8N_ENCRYPTION_KEY=change-me-four

# Notifications (Workflow C). Demo mode: at most NOTIFY_LIMIT emails per run,
# always sent to NOTIFY_RECIPIENTS (never to the addresses in the CSV).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_LIMIT=2
NOTIFY_RECIPIENTS=you@gmail.com,you+two@gmail.com
